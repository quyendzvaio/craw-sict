# Keys + provider LLM/VLM — COPY nội dung vào /home/ubuntu/craw-sict/.env trên VM1 rồi restart api:
#   ssh -i <khoá>.pem ubuntu@<IP-VM1>
#   nano ~/craw-sict/.env   # dán keys, lưu
#   cd ~/craw-sict && docker compose up -d api
# KHÔNG commit file .env thật.
#
# Yêu cầu provider: OpenAI-compatible — endpoint POST {BASE}/chat/completions,
# auth header "Authorization: Bearer {KEY}", body {model, messages, max_tokens,
# temperature[, stream]}. Hợp lệ: vLLM, llama.cpp server, Ollama (/v1),
# OpenAI, hoặc proxy tương thích. Không cần vision cho LLM chat (text-only);
# VLM caption ảnh mới cần model vision.

# --- LLM chat (trả lời /chat, rewrite query). BẮT BUỘC để có đáp án sinh ---
LLM_API_KEY=
# Base URL + model, mặc định trỏ gateway local (localhost:20128, model sict).
# Đổi khi dùng provider khác, VD OpenAI:
#LLM_API_BASE=https://api.openai.com/v1
#LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_MODEL=qwen/qwen3.8-27b

# --- VLM caption ảnh (cho pipeline annotate ảnh, mặc định TẮT → dùng OCR local) ---
VLM_API_KEY=
#VLM_API_BASE=https://api.openai.com/v1
#VLM_MODELS=gpt-4o-mini
#VLM_ENABLED=true
VLM_API_BASE=
VLM_MODELS=
VLM_ENABLED=false

# --- HuggingFace (tùy chọn, tăng rate-limit tải E5/CLIP) ---
HF_TOKEN=


# --- Embedding (D22: model đa phương thức jina-clip-v2, chữ+ảnh chung không gian) ---
# Mặc định EMBED_BACKEND=torch (E5 + CLIP, index v2). backend=api dùng endpoint dạng Jina
# (POST {BASE}/embeddings, input: [{"text":..}|{"image": base64}]). Endpoint + key sẽ được cấp sau.
# Index v3: QDRANT_COLLECTION_TEXT=sict_text_v3 QDRANT_COLLECTION_IMAGE=sict_image_v3 QDRANT_COLLECTION_OCR=sict_ocr_v3
#           QDRANT_TEXT_DIM=1024 QDRANT_IMAGE_DIM=1024
EMBED_BACKEND=
EMBED_API_BASE=
# tự host ONNX int8 (docker-compose.embed.yml, chỉ sau khi scripts/embed_parity.py PASS): EMBED_API_BASE=http://<host>:8090/v1, EMBED_API_KEY trống
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
# chỉ khi EMBED_API_BASE trỏ dịch vụ tự host: ảnh người dùng gửi chạy tháp ảnh 336 (dịch vụ phải có tháp này:
# EMBED_QUERY_IMAGE_SIZES của embed, mặc định 336; ảnh index giữ 512). Trên 2 vCPU: 336 ~3,8 s / ảnh, 392 ~5,3 s, 512 ~9,6 s
EMBED_QUERY_IMAGE_SIZE=336

# --- Giới hạn RAM container VM1 (MB, mặc định trong docker-compose.yml; tổng 3.650 trên máy 4 GB) ---
# API_MEM_LIMIT=1500m      # index v2 (torch, API tự nạp E5 + CLIP); sau cutover v3 (EMBED_BACKEND=api) đặt 600m
# QDRANT_MEM_LIMIT=1100m
# PG_MEM_LIMIT=600m

# --- D12: khoá store (VM1). Tạo ngẫu nhiên: scripts/store_auth.sh init-env; CD kiểm: store_auth.sh check vm1 ---
# Bỏ trống trên máy dev = store không khoá và cổng chỉ nghe 127.0.0.1 (như cũ). Chỉ A-Z a-z 0-9 _ -, ≥ 24 ký tự.
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# QDRANT_API_KEY=
# VM1: 0.0.0.0 để VM2 tới được — trên EC2 card mạng chỉ có IP private; Security Group chỉ cho SG của VM2 vào
# 5432 / 6379 / 6333-6334. Không đặt riêng IP private: Alloy trên VM1 đọc số liệu store qua localhost.
# STORE_BIND=127.0.0.1
