# VM2 worker: copy thành .env, điền IP VM1. KHÔNG commit file .env thật.
# VM1 giữ .env cũ (postgres/redis/qdrant local). VM2 dùng file này.

# --- Trỏ về VM1 (bắt buộc) — IP PRIVATE của VM1 (đổi nếu VM1 tạo lại) ---
# D12: mật khẩu / khoá = đúng giá trị POSTGRES_PASSWORD / REDIS_PASSWORD / QDRANT_API_KEY trong .env VM1
# (tạo bằng `scripts/store_auth.sh init-env` trên VM1). CD chạy `scripts/store_auth.sh check vm2` trước khi deploy.
POSTGRES_DSN=postgresql+asyncpg://sict:<POSTGRES_PASSWORD>@<IP-VM1>:5432/sict_crawler
REDIS_URL=redis://:<REDIS_PASSWORD>@<IP-VM1>:6379/0
QDRANT_HOST=<IP-VM1>
QDRANT_API_KEY=<QDRANT_API_KEY>
QDRANT_TIMEOUT=120

# --- Index v3 (BẮT BUỘC cho production, 2026-11-05) — cron đọc .env này qua env_file như API trên VM1 ---
# Thiếu khối này worker chạy mặc định config.yaml (torch E5 384-d, collection *_v2) và KHÔNG ghi được *_v3 1024-d.
# Kiểm trước khi bấm CD: `scripts/cutover_v3.sh env-check vm2` (chỉ in tên biến). Giá trị phải GIỐNG .env VM1.
EMBED_BACKEND=api
# dịch vụ embed int8 (docker-compose.embed.yml) chạy cùng thư mục ~/craw-sict → cùng project compose → tên service
# `embed` phân giải được từ cron. Nếu embed chạy nơi khác: http://<IP-private-VM2>:8090/v1 (EMBED_BIND bên dưới).
EMBED_API_BASE=http://embed:8090/v1
EMBED_API_KEY=
EMBED_MODEL=jina-clip-v2
EMBED_DIM=1024
# cache vector sqlite (tuỳ chọn, nằm trong volume localstore): bỏ trống = không cache
# EMBED_CACHE_PATH=/app/_local_store/embed_cache.sqlite
QDRANT_COLLECTION_TEXT=sict_text_v3
QDRANT_COLLECTION_IMAGE=sict_image_v3
QDRANT_COLLECTION_OCR=sict_ocr_v3
QDRANT_TEXT_DIM=1024
QDRANT_IMAGE_DIM=1024
# D23: chunk theo khối DOM (index v3 bật)
CHUNK_STRUCTURED=1

# --- Chu kỳ incremental (D31: 12h/lần, ngân sách 5 phút / lượt; bỏ trống = mặc định compose) ---
CHECK_EDITS=50
CRAWL_LIMIT=200
ANNOTATE_OCR_N=2000
# CYCLE_BUDGET_SEC=300
# CRON_INTERVAL_SEC=43200
# CRON_MEM_LIMIT=1024m   # đỉnh đo 408 MiB; phần còn lại của VM2 để embed

# --- S3 AWS (giống VM1, region us-east-2 = cùng region VM để khỏi tốn egress) ---
# AWS_PROFILE=quyen-admin
# Hoặc key rời nếu VM2 không có ~/.aws:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=  # để trống = AWS thật

CRAWLER_BACKEND=auto
HF_TOKEN=

# --- Image (CD ghi tự động, D10 — không sửa tay; rollback = chạy CD với tag cũ) ---
# WORKER_IMAGE=ghcr.io/quyendzvaio/sict-worker:<sha>
# EMBED_IMAGE=ghcr.io/quyendzvaio/sict-embed:<sha>
# Dịch vụ embed (docker-compose.embed.yml): nghe trên IP private VM2 để API ở VM1 gọi được (SG chỉ mở 8090 cho VM1)
EMBED_BIND=<IP-private-VM2>
# EMBED_QUERY_IMAGE_SIZES=336   # tháp ảnh truy vấn của embed; API trên VM1 đặt EMBED_QUERY_IMAGE_SIZE cùng giá trị
