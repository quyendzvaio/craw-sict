# VM2 worker: copy thành .env, điền IP VM1. KHÔNG commit file .env thật.
# VM1 giữ .env cũ (postgres/redis/qdrant local). VM2 dùng file này.

# --- Trỏ về VM1 (bắt buộc) — IP PRIVATE của VM1 (đổi nếu VM1 tạo lại) ---
POSTGRES_DSN=postgresql+asyncpg://sict:sict@<IP-VM1>:5432/sict_crawler
REDIS_URL=redis://<IP-VM1>:6379/0
QDRANT_HOST=<IP-VM1>
QDRANT_TIMEOUT=120

# --- Chu kỳ incremental (D31: 12h/lần, ngân sách 5 phút / lượt; bỏ trống = mặc định compose) ---
CHECK_EDITS=50
CRAWL_LIMIT=200
ANNOTATE_OCR_N=2000
# CYCLE_BUDGET_SEC=300
# CRON_INTERVAL_SEC=43200
# CRON_MEM_LIMIT=1024m   # đỉnh đo 408 MiB; phần còn lại của VM2 để embed

# --- S3 AWS (giống VM1, region us-east-2 = cùng region VM để khỏi tốn egress) ---
# AWS_PROFILE=quyen-admin
# Hoặc key rời nếu VM2 không có ~/.aws:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=  # để trống = AWS thật

CRAWLER_BACKEND=auto
HF_TOKEN=

# --- Image (CD ghi tự động, D10 — không sửa tay; rollback = chạy CD với tag cũ) ---
# WORKER_IMAGE=ghcr.io/quyendzvaio/sict-worker:<sha>
# EMBED_IMAGE=ghcr.io/quyendzvaio/sict-embed:<sha>
# Dịch vụ embed (docker-compose.embed.yml): nghe trên IP private VM2 để API ở VM1 gọi được (SG chỉ mở cho VM1)
# EMBED_BIND=<IP-private-VM2>
