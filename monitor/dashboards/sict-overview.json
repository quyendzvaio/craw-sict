   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 16,
    "y": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "expr": "sum(rate(sict_http_requests_total{instance=~\"$instance\",status=~\"5..\"}[$__rate_interval])) / sum(rate(sict_http_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
     "legendFormat": "5xx"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {}
  },
